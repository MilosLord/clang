# Osnovna pravila koja vaze pre nego sto se clang-format uopste pokrene.
# Editori (nvim via editorconfig, VS, Rider, VSCode) ovo citaju automatski.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# std profil: 4 space
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl}]
indent_style = space
indent_size = 4
max_line_length = 120

# unreal profil: tabovi. install.sh unreal prepisuje ovaj blok u projekat.
[{Source,Plugins}/**.{cpp,h,inl}]
indent_style = tab
indent_size = 4
max_line_length = 140

[*.{Build,Target}.cs]
indent_style = tab
indent_size = 4

[*.{json,uproject,uplugin,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
