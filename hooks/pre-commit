#!/usr/bin/env bash
# pre-commit hook — FAIL-CLOSED enforcement. Ako nesto ne moze da se proveri, commit pada.
#
#   1. clang-format --dry-run --Werror na STAGED sadrzaju svakog C/C++ fajla
#   2. NOLINT disciplina:
#        - jedini dozvoljeni oblik za velicinu funkcije je
#            // NOLINTNEXTLINE(readability-function-size) one-shot: <razlog>
#        - NOLINT / NOLINTNEXTLINE / NOLINTBEGIN bez liste check-ova (gase SVE) su zabranjeni
#        - NOLINT(readability-function-size) i NOLINTBEGIN(...function-size...) su zabranjeni
#   3. hard cap: nijedna funkcija > 50 linija — proverava se KOPIJA sa uklonjenim NOLINT-ovima
#      (NOLINT je in-source supresija, --config ne moze da je pregazi)
#   4. ostali pragovi readability-function-size iz projektnog .clang-tidy (parametri, nesting,
#      branches, variables) — takodje na kopiji bez NOLINT-a, sa LineThreshold iskljucenim.
#      One-shot izuzetak vazi SAMO za broj linija.
#
#   Kopija ide u isti direktorijum (.precommit_<ime>) da relativni include-ovi rade; ako projekat
#   ima compile_commands.json, kopiji se podmetne compile komanda originala. Ako clang-tidy ne
#   moze da parsira fajl (npr. UE bez compile_commands.json) -> commit ODBIJEN, ne preskocen.
#
# Zaobilazenje u nuzdi: git commit --no-verify   (i objasni u poruci zasto)

set -uo pipefail

HARD_CAP_LINES="${CLANG_HOOK_HARD_CAP:-50}"
CLANG_FORMAT="${CLANG_FORMAT:-clang-format}"
CLANG_TIDY="${CLANG_TIDY:-clang-tidy}"

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
die()    { red "pre-commit: $*"; red "pre-commit: ODBIJENO."; exit 1; }

repo_root="$(git rev-parse --show-toplevel)" || die "nije git repo?"
cd "$repo_root"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx|inl)$' \
    | grep -vE '(\.generated\.h|\.gen\.cpp|/Intermediate/|/Binaries/|/ThirdParty/)' || true)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# alati su obavezni — bez njih nema "hard cap"
command -v "$CLANG_FORMAT" >/dev/null 2>&1 || die "'$CLANG_FORMAT' nije na PATH-u (pip install clang-format, ili CLANG_FORMAT=/putanja)"
command -v "$CLANG_TIDY"   >/dev/null 2>&1 || die "'$CLANG_TIDY' nije na PATH-u (pip install clang-tidy, ili CLANG_TIDY=/putanja)"
command -v python3         >/dev/null 2>&1 || die "python3 nije na PATH-u"

fail=0
tmp_files=()
tmp_dir="$(mktemp -d)"
cleanup() { [[ ${#tmp_files[@]} -gt 0 ]] && rm -f "${tmp_files[@]}"; rm -rf "$tmp_dir"; return 0; }
trap cleanup EXIT

# ------------------------------------------------------------------ 1. format ---
format_bad=()
for f in "${staged[@]}"; do
    if ! git show ":$f" | "$CLANG_FORMAT" --assume-filename="$f" --dry-run --Werror >/dev/null 2>&1; then
        format_bad+=("$f")
    fi
done
if [[ ${#format_bad[@]} -gt 0 ]]; then
    red "pre-commit: clang-format — nisu formatirani:"
    printf '    %s\n' "${format_bad[@]}"
    yellow "    fix:  $CLANG_FORMAT -i ${format_bad[*]} && git add ${format_bad[*]}"
    fail=1
fi

# --------------------------------------------------------- 2. NOLINT disciplina ---
nolint_bad=()
for f in "${staged[@]}"; do
    while IFS= read -r hit; do
        [[ -z "$hit" ]] && continue
        lineno="${hit%%:*}"; text="${hit#*:}"
        # dozvoljeno: NOLINTNEXTLINE(readability-function-size) one-shot: <nesto>
        if [[ "$text" =~ NOLINTNEXTLINE\(readability-function-size\)[[:space:]]+one-shot:[[:space:]]*[^[:space:]] ]]; then
            continue
        fi
        # dozvoljeno: NOLINT* sa listom check-ova koja NE sadrzi function-size i nije prazna
        if [[ "$text" =~ NOLINT(NEXTLINE|BEGIN|END)?\(([^\)]+)\) ]]; then
            checks="${BASH_REMATCH[2]}"
            if [[ "$checks" != *"readability-function-size"* && "$checks" != *"readability-*"* && "$checks" != "*" ]]; then
                continue
            fi
        fi
        # NOLINTEND bez liste je ok samo ako je i BEGIN imao listu — uprosceno: END bez liste zabranjujemo
        nolint_bad+=("$f:$lineno: ${text#"${text%%[![:space:]]*}"}")
    done < <(git show ":$f" | grep -nE 'NOLINT' || true)
done
if [[ ${#nolint_bad[@]} -gt 0 ]]; then
    red "pre-commit: nedozvoljen NOLINT (za velicinu funkcije jedini oblik je"
    red "            '// NOLINTNEXTLINE(readability-function-size) one-shot: <razlog>'; bez liste check-ova je zabranjeno):"
    printf '    %s\n' "${nolint_bad[@]}"
    fail=1
fi

# ------------------------------------ 3+4. velicina funkcije na kopiji bez NOLINT ---
db=""
# Redosled: env CLANG_TIDY_BUILD_DIR > git config clang.tidyBuildDir > root/build/... > find (jedina)
build_dir="${CLANG_TIDY_BUILD_DIR:-$(git config --get clang.tidyBuildDir || true)}"
if [[ -n "$build_dir" ]]; then
    db="$build_dir"
    [[ -d "$db" ]] && db="$db/compile_commands.json"
    [[ -f "$db" ]] || die "CLANG_TIDY_BUILD_DIR / git config clang.tidyBuildDir ne pokazuje na compile_commands.json: $db"
else
    for cand in . build out/build Build; do
        [[ -f "$cand/compile_commands.json" ]] && { db="$cand/compile_commands.json"; break; }
    done
    if [[ -z "$db" ]]; then
        mapfile -t databases < <(find . -maxdepth 4 -type f -name compile_commands.json \
            -not -path './.git/*' -not -path '*/ThirdParty/*' -not -path '*/vendor/*' | sort)
        if [[ ${#databases[@]} -eq 1 ]]; then
            db="${databases[0]}"
        elif [[ ${#databases[@]} -gt 1 ]]; then
            die "vise compile baza; izaberi jednom:  git config clang.tidyBuildDir build/<preset>   (ili env CLANG_TIDY_BUILD_DIR). Nadjene: ${databases[*]}"
        fi
    fi
fi

# Pravi collision-safe .precommit_* kopije bez NOLINT-a + privremeni
# compile_commands.json. Ispisuje: <tmp>\t<orig>\t<has_cmd>.
mapping_file="$tmp_dir/mapping"
if ! python3 - "$repo_root" "$db" "$tmp_dir" "${staged[@]}" > "$mapping_file" <<'PY'
import json, os, re, subprocess, sys, tempfile
root, db, tmp_dir, *files = sys.argv[1:]
entries = {}
if db:
    with open(db, encoding="utf-8") as fh:
        for e in json.load(fh):
            entries[os.path.normpath(os.path.join(e.get("directory", root), e["file"]))] = e
out_db = []
created = []
try:
    for f in files:
        src = subprocess.run(["git", "show", f":{f}"], capture_output=True, text=True, check=True).stdout
        src = re.sub(r"NOLINT(NEXTLINE|BEGIN|END)?", "NOLINT_OFF", src)
        d, b = os.path.split(f)
        source_dir = os.path.join(root, d)
        fd, tmp_abs = tempfile.mkstemp(prefix=".precommit_", suffix=f"_{b}", dir=source_dir, text=True)
        created.append(tmp_abs)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(src)
        tmp = os.path.relpath(tmp_abs, root)
        orig_abs = os.path.normpath(os.path.join(root, f))
        e = entries.get(orig_abs)
        has = "0"
        if e:
            e = dict(e); e["file"] = tmp_abs
            if "command" in e:
                e["command"] = e["command"].replace(orig_abs, tmp_abs).replace(f, tmp)
            if "arguments" in e:
                e["arguments"] = [a.replace(orig_abs, tmp_abs).replace(f, tmp) for a in e["arguments"]]
            e.pop("output", None)
            out_db.append(e); has = "1"
        print(f"{tmp}\t{f}\t{has}")
    with open(os.path.join(tmp_dir, "compile_commands.json"), "w", encoding="utf-8") as fh:
        json.dump(out_db, fh)
except BaseException:
    for path in created:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    raise
PY
then
    die "priprema kopija nije uspela"
fi
mapfile -t mapping < "$mapping_file"

cap_cfg="{CheckOptions: {readability-function-size.LineThreshold: ${HARD_CAP_LINES}, readability-function-size.StatementThreshold: -1, readability-function-size.BranchThreshold: -1, readability-function-size.ParameterThreshold: -1, readability-function-size.NestingThreshold: -1, readability-function-size.VariableThreshold: -1}}"

cap_bad=(); other_bad=(); analyze_bad=(); index=0
for line in "${mapping[@]}"; do
    index=$((index + 1))
    IFS=$'\t' read -r tmp orig has <<<"$line"
    tmp_files+=("$tmp")
    if [[ "$has" == "1" ]]; then comp=(-p "$tmp_dir"); else comp=(--); fi

    # (3) hard cap — sopstveni config, samo broj linija
    cap_log="$tmp_dir/cap.$index.log"
    if "$CLANG_TIDY" --quiet --checks='-*,readability-function-size' --config="$cap_cfg" \
            --warnings-as-errors='readability-function-size' "$tmp" "${comp[@]}" >"$cap_log" 2>&1; then
        cap_rc=0
    else
        cap_rc=$?
    fi
    cap_diag="$(grep -E 'readability-function-size|threshold' "$cap_log" || true)"
    analyze_diag="$(grep -E '(^|[[:space:]])(error|Error|fatal error):|Error while processing' "$cap_log" \
        | grep -vE 'readability-function-size' | head -1 || true)"
    if [[ -n "$analyze_diag" || ($cap_rc -ne 0 && -z "$cap_diag") ]]; then
        detail="${analyze_diag:-clang-tidy je zavrsio statusom $cap_rc bez dijagnostike}"
        analyze_bad+=("$orig: $(printf '%s' "$detail" | sed "s#$repo_root/##g; s#$tmp#$orig#g")")
        continue
    fi
    [[ -n "$cap_diag" ]] && cap_bad+=("$(printf '%s\n' "$cap_diag" | sed "s#$repo_root/##g; s#$tmp#$orig#g")")

    # (4) ostali pragovi iz projektnog .clang-tidy, LineThreshold iskljucen
    dump_log="$tmp_dir/dump.$index.log"
    if "$CLANG_TIDY" --dump-config "$tmp" "${comp[@]}" >"$dump_log" 2>&1; then
        dump_rc=0
    else
        dump_rc=$?
        analyze_bad+=("$orig: clang-tidy --dump-config nije uspeo (status $dump_rc): $(head -1 "$dump_log")")
        continue
    fi
    dumped="$(cat "$dump_log")"
    if [[ -n "$dumped" ]] && printf '%s' "$dumped" | grep -qE 'readability-function-size\.(Parameter|Nesting|Branch|Variable|Statement)Threshold'; then
        cfg_file="$tmp_dir/other.$(basename "$tmp").yaml"
        printf '%s\n' "$dumped" | sed -E "s/^([[:space:]]*readability-function-size\.LineThreshold:).*/\1 '-1'/" > "$cfg_file"
        other_log="$tmp_dir/other.$index.log"
        if "$CLANG_TIDY" --quiet --config-file="$cfg_file" --checks='-*,readability-function-size' \
                --warnings-as-errors='readability-function-size' "$tmp" "${comp[@]}" >"$other_log" 2>&1; then
            other_rc=0
        else
            other_rc=$?
        fi
        other_diag="$(grep -E 'readability-function-size|threshold' "$other_log" || true)"
        analyze_diag="$(grep -E '(^|[[:space:]])(error|Error|fatal error):|Error while processing' "$other_log" \
            | grep -vE 'readability-function-size' | head -1 || true)"
        if [[ -n "$analyze_diag" || ($other_rc -ne 0 && -z "$other_diag") ]]; then
            detail="${analyze_diag:-clang-tidy je zavrsio statusom $other_rc bez dijagnostike}"
            analyze_bad+=("$orig: $(printf '%s' "$detail" | sed "s#$repo_root/##g; s#$tmp#$orig#g")")
            continue
        fi
        [[ -n "$other_diag" ]] && other_bad+=("$(printf '%s\n' "$other_diag" | sed "s#$repo_root/##g; s#$tmp#$orig#g")")
    fi
done

if [[ ${#analyze_bad[@]} -gt 0 ]]; then
    red "pre-commit: clang-tidy ne moze da analizira (fail-closed). UE projekat? -> generisi compile_commands.json u root:"
    printf '    %s\n' "${analyze_bad[@]}"
    fail=1
fi
if [[ ${#cap_bad[@]} -gt 0 ]]; then
    red "pre-commit: funkcija preko ${HARD_CAP_LINES} linija (hard cap, NOLINT ne pomaze):"
    printf '%s\n' "${cap_bad[@]}" | sed 's/^/    /'
    yellow "    Razbij funkciju. One-shot izuzetak ide do 50, ne dalje."
    fail=1
fi
if [[ ${#other_bad[@]} -gt 0 ]]; then
    red "pre-commit: prekoracen prag (parametri/nesting/branches/variables) — one-shot NOLINT vazi samo za broj linija:"
    printf '%s\n' "${other_bad[@]}" | sed 's/^/    /'
    fail=1
fi

[[ $fail -ne 0 ]] && die "vidi gore"
green "pre-commit: OK (${#staged[@]} fajl/ova)"
exit 0
