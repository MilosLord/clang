#!/usr/bin/env bash
# pre-commit hook: enforcement koji NE MOZE da se zaobidje NOLINT-om.
#
#   1. clang-format --dry-run --Werror  na svim staged C/C++ fajlovima
#   2. hard cap: nijedna funkcija > 50 linija.
#      NOLINT je in-source supresija i radi bez obzira na --config, pa hook proverava
#      KOPIJU staged sadrzaja u kojoj je svaki `NOLINT*` zamenjen sa `NOLINT_OFF`.
#      Kopija ide u isti direktorijum (.precommit_<ime>) da relativni include-ovi rade,
#      a ako projekat ima compile_commands.json, kopiji se podmetne compile komanda
#      originala (privremeni compile_commands.json) da se UE/CMake kod parsira kako treba.
#
# Editor (clangd + .clang-tidy iz projekta) prijavljuje warning vec na 30 linija;
# 30..50 je dozvoljeno samo uz `// NOLINTNEXTLINE(readability-function-size) one-shot: <razlog>`.
#
# Instalira ga: install.sh <profil> <project_dir>   (kopira u .git/hooks/pre-commit)
# Zaobilazenje u nuzdi: git commit --no-verify   (i objasni u poruci zasto)

set -euo pipefail

HARD_CAP_LINES="${CLANG_HOOK_HARD_CAP:-50}"
CLANG_FORMAT="${CLANG_FORMAT:-clang-format}"
CLANG_TIDY="${CLANG_TIDY:-clang-tidy}"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(c|cc|cpp|cxx|h|hh|hpp|hxx|inl)$' \
    | grep -vE '(\.generated\.h|\.gen\.cpp|/Intermediate/|/Binaries/|/ThirdParty/)' || true)

if [[ ${#staged[@]} -eq 0 ]]; then
    exit 0
fi

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }

fail=0
tmp_files=()
tmp_db_dir=""
cleanup() {
    [[ ${#tmp_files[@]} -gt 0 ]] && rm -f "${tmp_files[@]}"
    [[ -n "$tmp_db_dir" ]] && rm -rf "$tmp_db_dir"
    return 0
}
trap cleanup EXIT

# ---------------------------------------------------------------- 1. format ---
if ! command -v "$CLANG_FORMAT" >/dev/null 2>&1; then
    red "pre-commit: '$CLANG_FORMAT' nije na PATH-u. Instaliraj ga ili postavi CLANG_FORMAT=..."
    exit 1
fi

format_bad=()
for f in "${staged[@]}"; do
    # proveravamo STAGED sadrzaj, ne radni fajl (mogu da se razlikuju)
    if ! git show ":$f" | "$CLANG_FORMAT" --assume-filename="$f" --dry-run --Werror >/dev/null 2>&1; then
        format_bad+=("$f")
    fi
done

if [[ ${#format_bad[@]} -gt 0 ]]; then
    red "pre-commit: clang-format — sledeci fajlovi nisu formatirani:"
    printf '    %s\n' "${format_bad[@]}"
    yellow "    fix:  $CLANG_FORMAT -i ${format_bad[*]} && git add ${format_bad[*]}"
    fail=1
fi

# ------------------------------------------------------- 2. hard cap 50 lin ---
if ! command -v "$CLANG_TIDY" >/dev/null 2>&1; then
    yellow "pre-commit: '$CLANG_TIDY' nije na PATH-u — preskacem proveru velicine funkcija."
else
    # compile_commands.json: root, ./build, ili gde vec
    db=""
    for cand in . build out/build Build; do
        if [[ -f "$cand/compile_commands.json" ]]; then db="$cand/compile_commands.json"; break; fi
    done

    tmp_db_dir="$(mktemp -d)"

    # Pravi .precommit_<ime> kopije bez NOLINT-a + privremeni compile_commands.json
    # u kome su fajlovi originala zamenjeni kopijama. Ispisuje: <tmp>\t<orig>\t<has_cmd>
    mapfile -t mapping < <(python3 - "$repo_root" "$db" "$tmp_db_dir" "${staged[@]}" <<'PY'
import json, os, re, subprocess, sys
root, db, tmp_db_dir, *files = sys.argv[1:]
entries = {}
if db:
    try:
        for e in json.load(open(db)):
            entries[os.path.normpath(os.path.join(e.get("directory", root), e["file"]))] = e
    except Exception:
        entries = {}
out_db = []
for f in files:
    src = subprocess.run(["git", "show", f":{f}"], capture_output=True, text=True, check=True).stdout
    src = re.sub(r"NOLINT(NEXTLINE|BEGIN|END)?", "NOLINT_OFF", src)
    d, b = os.path.split(f)
    tmp = os.path.join(d, f".precommit_{b}") if d else f".precommit_{b}"
    with open(tmp, "w") as fh:
        fh.write(src)
    orig_abs = os.path.normpath(os.path.join(root, f))
    tmp_abs = os.path.normpath(os.path.join(root, tmp))
    e = entries.get(orig_abs)
    has = "0"
    if e:
        e = dict(e)
        e["file"] = tmp_abs
        if "command" in e:
            e["command"] = e["command"].replace(orig_abs, tmp_abs).replace(f, tmp)
        if "arguments" in e:
            e["arguments"] = [a.replace(orig_abs, tmp_abs).replace(f, tmp) for a in e["arguments"]]
        e.pop("output", None)
        out_db.append(e)
        has = "1"
    print(f"{tmp}\t{f}\t{has}")
json.dump(out_db, open(os.path.join(tmp_db_dir, "compile_commands.json"), "w"))
PY
)

    with_cmd=(); without_cmd=()
    declare -A back
    for line in "${mapping[@]}"; do
        IFS=$'\t' read -r tmp orig has <<<"$line"
        tmp_files+=("$tmp"); back["$tmp"]="$orig"
        if [[ "$has" == "1" ]]; then with_cmd+=("$tmp"); else without_cmd+=("$tmp"); fi
    done

    tidy_common=(
        --quiet
        --checks='-*,readability-function-size'
        --config="{CheckOptions: {readability-function-size.LineThreshold: ${HARD_CAP_LINES}, readability-function-size.StatementThreshold: -1, readability-function-size.BranchThreshold: -1, readability-function-size.ParameterThreshold: -1, readability-function-size.NestingThreshold: -1, readability-function-size.VariableThreshold: -1}}"
        --warnings-as-errors='readability-function-size'
    )

    cap_out=""
    if [[ ${#with_cmd[@]} -gt 0 ]]; then
        cap_out+="$("$CLANG_TIDY" "${tidy_common[@]}" -p "$tmp_db_dir" "${with_cmd[@]}" 2>/dev/null \
            | grep -E 'readability-function-size|threshold' || true)"$'\n'
    fi
    if [[ ${#without_cmd[@]} -gt 0 ]]; then
        # bez compile komande: parsiraj bez flagova (dovoljno za brojanje linija)
        cap_out+="$("$CLANG_TIDY" "${tidy_common[@]}" "${without_cmd[@]}" -- 2>/dev/null \
            | grep -E 'readability-function-size|threshold' || true)"
    fi

    # ime kopije -> ime originala u izvestaju
    for tmp in "${!back[@]}"; do
        cap_out="${cap_out//$tmp/${back[$tmp]}}"
        cap_out="${cap_out//$repo_root\//}"
    done
    cap_out="$(printf '%s' "$cap_out" | sed '/^[[:space:]]*$/d')"

    if [[ -n "$cap_out" ]]; then
        red "pre-commit: funkcija preko ${HARD_CAP_LINES} linija (hard cap, NOLINT ne pomaze):"
        printf '%s\n' "$cap_out" | sed 's/^/    /'
        yellow "    Razbij funkciju. Ako je stvarno one-shot, 30..50 je granica, ne vise."
        fail=1
    fi
fi

if [[ $fail -ne 0 ]]; then
    red "pre-commit: ODBIJENO."
    exit 1
fi

green "pre-commit: OK (${#staged[@]} fajl/ova)"
exit 0
