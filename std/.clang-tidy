---
# std profil — generalni C++23. Naming: PascalCase (kao UE) da bude jedan stil u glavi.
#
# Pravilo velicine funkcija (vazi za SVE profile):
#   - > 30 linija  -> warning ovde (clangd ga prikazuje inline u editoru)
#   - 30..50       -> dozvoljeno SAMO uz eksplicitan opt-in iznad funkcije:
#                     // NOLINTNEXTLINE(readability-function-size) one-shot: <razlog>
#   - > 50         -> hooks/pre-commit odbija commit (hard cap, NOLINT ne pomaze,
#                     hook prosledjuje sopstveni --config sa pragom 50)
#
# Trailing return type (`auto F() -> int`) je obavezan u std profilu. U unreal
# profilu je iskljucen jer UHT ne parsira `auto Foo() -> int` na UFUNCTION-ima.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  cert-dcl50-cpp,
  cert-dcl58-cpp,
  cert-err34-c,
  cert-err52-cpp,
  cert-err60-cpp,
  cert-flp30-c,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-macro-usage,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  misc-const-correctness,
  misc-definitions-in-headers,
  misc-include-cleaner,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-static-assert,
  misc-unconventional-assign-operator,
  misc-unused-alias-decls,
  misc-unused-parameters,
  misc-unused-using-decls,
  misc-use-anonymous-namespace,
  modernize-*,
  -modernize-use-designated-initializers,
  performance-*,
  readability-avoid-const-params-in-decls,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-container-contains,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  readability-else-after-return,
  readability-function-cognitive-complexity,
  readability-function-size,
  readability-identifier-naming,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-isolate-declaration,
  readability-magic-numbers,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-qualified-auto,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
  readability-static-definition-in-anonymous-namespace,
  readability-string-compare,
  readability-uniqueptr-delete-release,
  readability-use-anyofallof

# Ovi se tretiraju kao greske i u editoru, ne samo u hook-u.
WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  cppcoreguidelines-slicing,
  modernize-use-trailing-return-type,
  readability-braces-around-statements

HeaderFilterRegex: '.*'
FormatStyle: file

CheckOptions:
  # --- velicina / kompleksnost -------------------------------------------
  readability-function-size.LineThreshold: 30
  readability-function-size.StatementThreshold: 60
  readability-function-size.BranchThreshold: 8
  readability-function-size.ParameterThreshold: 5
  readability-function-size.NestingThreshold: 4
  readability-function-size.VariableThreshold: 12
  readability-function-cognitive-complexity.Threshold: 15
  readability-function-cognitive-complexity.IgnoreMacros: true

  # --- magic numbers ------------------------------------------------------
  readability-magic-numbers.IgnoredIntegerValues: '0;1;2;3;4;8;10;16;32;64;100;255;256;1024'
  readability-magic-numbers.IgnoredFloatingPointValues: '0.0;0.5;1.0;2.0;100.0'
  readability-magic-numbers.IgnorePowersOf2IntegerValues: true
  readability-magic-numbers.IgnoreBitFieldsWidths: true

  # --- naming: PascalCase (clang-tidy 'CamelCase' == PascalCase) -----------
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^(main|swap|begin|end|cbegin|cend|size|empty|data|hash|operator.*)$'
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.MethodIgnoredRegexp: '^(swap|begin|end|cbegin|cend|size|empty|data|operator.*)$'
  readability-identifier-naming.VariableCase: CamelCase
  readability-identifier-naming.ParameterCase: CamelCase
  readability-identifier-naming.MemberCase: CamelCase
  readability-identifier-naming.PrivateMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberCase: CamelCase
  readability-identifier-naming.ConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^_.*|.*_H$|.*_HPP$'
  # 1-2 slova (i, j, x, y, dt, it) su dozvoljena kao lokalne / param
  readability-identifier-naming.VariableIgnoredRegexp: '^[a-z]{1,2}$'
  readability-identifier-naming.ParameterIgnoredRegexp: '^[a-z]{1,2}$'

  # --- ostalo -------------------------------------------------------------
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-implicit-bool-conversion.AllowIntegerConditions: false
  modernize-use-nodiscard.ReplacementString: '[[nodiscard]]'
  modernize-use-override.IgnoreDestructors: false
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  misc-include-cleaner.IgnoreHeaders: ''
  performance-move-const-arg.CheckTriviallyCopyableMove: false
  bugprone-narrowing-conversions.WarnOnIntegerNarrowingConversion: true
...
